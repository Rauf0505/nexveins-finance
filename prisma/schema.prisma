// Nex Veins Finance — domain model.
//
// Two rules shape every model below and are worth knowing before editing:
//
// 1. No stored balance columns. Accounts receivable, accounts payable, cash,
//    and project cost are derived from journal lines through SQL views created
//    in the migration (see prisma/migrations). The legacy app hand-updated
//    `current_balance`/`balance`/`invoiced_amount` from nine different routes
//    and could silently drift; that failure mode is designed out here.
//
// 2. Money is Postgres NUMERIC, never float. Amounts use Decimal in
//    application code and NUMERIC(19,2) in the database. Currency precision is
//    declared on Currency and enforced at the write boundary.
//
// Better Auth owns user/session/account/organization/member/invitation tables.
// Its models are generated into this file by `npx @better-auth/cli generate`
// and marked with the "better-auth" region below.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Money and reference data
// ---------------------------------------------------------------------------

model Currency {
  code                String   @id
  name                String
  /// Number of decimal places carried by amounts in this currency.
  minorUnitScale      Int      @default(2)
  /// Rounding policy applied when an amount must be reduced to scale.
  roundingMode        String   @default("HALF_UP")
  isActive            Boolean  @default(true)
  organizations       Organization[]

  @@map("currencies")
}

model Organization {
  id          String   @id
  name        String
  slug        String   @unique
  /// Set once the tenant is configured; blocks partial-state posting.
  isConfigured Boolean @default(false)

  baseCurrencyCode String
  baseCurrency     Currency @relation(fields: [baseCurrencyCode], references: [code])

  fiscalYearStartMonth Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts            Account[]
  accountRoles        AccountRoleAssignment[]
  fiscalPeriods       FiscalPeriod[]
  documentSequences   DocumentSequence[]
  journalEntries      JournalEntry[]
  clients             Client[]
  vendors             Vendor[]
  projects            Project[]
  invoices            Invoice[]
  creditNotes         CreditNote[]
  receipts            Receipt[]
  bills               Bill[]
  billPayments        BillPayment[]
  bankAccounts        BankAccount[]
  bankStatements      BankStatement[]
  bankTransfers       BankTransfer[]
  auditEvents         AuditEvent[]

  // Membership and invitation models are generated by the better-auth
  // organization plugin; see the better-auth region at the end of this file.

  @@index([baseCurrencyCode])
  @@map("organizations")
}

// ---------------------------------------------------------------------------
// Chart of accounts
// ---------------------------------------------------------------------------

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountSubType {
  CASH_AND_BANK
  ACCOUNTS_RECEIVABLE
  CURRENT_ASSET
  FIXED_ASSET
  CONTRA_ASSET
  ACCOUNTS_PAYABLE
  CURRENT_LIABILITY
  NON_CURRENT_LIABILITY
  TAX_PAYABLE
  PARTNER_CAPITAL
  RETAINED_EARNINGS
  PROJECT_REVENUE
  SERVICE_REVENUE
  COST_OF_REVENUE
  DIRECT_LABOR_COST
  OPERATING_EXPENSE
  OTHER_EXPENSE
}

model Account {
  id             String      @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  code       String
  name       String
  type       AccountType
  subType    AccountSubType
  /// Hierarchical COA support: accounts may roll up to a parent.
  parentId   String?
  parent     Account?    @relation("AccountTree", fields: [parentId], references: [id])
  children   Account[]   @relation("AccountTree")

  /// True when a subledger owns the balance. Direct manual lines against a
  /// control account are rejected by the posting service.
  isSystemControl Boolean @default(false)
  isActive        Boolean @default(true)
  description     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleAssignments AccountRoleAssignment[]
  journalLines    JournalLine[]
  bankAccounts    BankAccount[]

  @@unique([organizationId, code])
  @@index([organizationId, type])
  @@map("chart_of_accounts")
}

/// Every posting rule asks "which account plays this role for this
/// organization?" instead of looking up a hardcoded code such as '5010' or
/// `code LIKE '%23%'`. Roles are required before an organization is marked
/// configured, so a misconfigured tenant cannot post half-right entries.
enum AccountRole {
  AR_CONTROL
  AP_CONTROL
  CASH_ON_HAND
  BANK_OPERATING
  REVENUE_CONTRACT
  REVENUE_RETAINER
  COST_OF_REVENUE
  DIRECT_LABOR
  OPEX_DEFAULT
  OUTPUT_TAX_PAYABLE
  INPUT_TAX_RECEIVABLE
  WITHHOLDING_PAYABLE
  SALARY_EXPENSE
  SALARY_PAYABLE
  DEPRECIATION_EXPENSE
  ACCUMULATED_DEPRECIATION
  FIXED_ASSET
  PARTNER_CAPITAL
  PARTNER_DRAWING
  RETAINED_EARNINGS
  OPENING_BALANCE
  SUSPENSE
}

model AccountRoleAssignment {
  id             String  @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account @relation(fields: [accountId], references: [id])
  role           AccountRole

  @@unique([organizationId, role])
  @@index([accountId])
  @@map("account_role_assignments")
}

// ---------------------------------------------------------------------------
// Fiscal calendar and document numbering
// ---------------------------------------------------------------------------

model FiscalPeriod {
  id             String  @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name       String
  startDate  DateTime
  endDate    DateTime
  isLocked   Boolean  @default(false)
  isClosed   Boolean  @default(false)
  closedAt   DateTime?
  closedBy   String?

  createdAt DateTime @default(now())

  journalEntries JournalEntry[]

  @@unique([organizationId, startDate, endDate])
  @@index([organizationId, endDate])
  @@map("fiscal_periods")
}

/// Atomic, gap-aware document numbering. The legacy app derived
/// `count(*) + 1` inside the request, which produced duplicate invoice and
/// journal numbers under concurrency. A row locked per (org, kind) inside the
/// posting transaction removes the race.
enum DocumentKind {
  JOURNAL_ENTRY
  INVOICE
  CREDIT_NOTE
  RECEIPT
  BILL
  BILL_PAYMENT
  BANK_TRANSFER
}

model DocumentSequence {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           DocumentKind
  pattern        String       @default("{prefix}-{year}-{counter}")
  prefix         String
  nextValue      Int          @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([organizationId, kind])
  @@map("document_sequences")
}

// ---------------------------------------------------------------------------
// Counterparties and projects
// ---------------------------------------------------------------------------

model Client {
  id             String  @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name              String
  companyName       String?
  email             String?
  phone             String?
  taxNumber         String?
  address           String?
  currencyCode      String
  paymentTermsDays  Int      @default(30)
  /// Soft delete: history and open receivables must survive archival.
  isArchived        Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices     Invoice[]
  creditNotes  CreditNote[]
  receipts     Receipt[]
  projects     Project[]

  @@index([organizationId, name])
  @@map("clients")
}

model Vendor {
  id             String  @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name             String
  companyName      String?
  email            String?
  phone            String?
  taxNumber        String?
  category         String    @default("General")
  currencyCode     String
  paymentTermsDays Int       @default(30)
  isArchived       Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bills       Bill[]
  payments    BillPayment[]

  @@index([organizationId, name])
  @@map("vendors")
}

enum BillingModel {
  FIXED_PRICE
  HOURLY
  MILESTONE
  RETAINER
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
  CANCELLED
}

model Project {
  id             String  @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  code      String
  name      String
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])
  billingModel BillingModel @default(FIXED_PRICE)
  status       ProjectStatus @default(ACTIVE)

  contractValue      Decimal @default(0) @db.Decimal(19, 2)
  budgetCostBaseline Decimal @default(0) @db.Decimal(19, 2)
  plannedLaborCost   Decimal @default(0) @db.Decimal(19, 2)

  startDate DateTime
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices     Invoice[]
  bills        Bill[]
  journalLines JournalLine[]

  @@unique([organizationId, code])
  @@map("projects")
}

// ---------------------------------------------------------------------------
// The ledger
// ---------------------------------------------------------------------------

enum JournalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  POSTED
  REVERSED
  VOIDED
}

/// What produced the entry. Kept as an open list of domain documents; a new
/// transaction type adds a posting map, not a new place that writes SQL.
enum SourceType {
  MANUAL
  OPENING_BALANCE
  INVOICE
  CREDIT_NOTE
  RECEIPT
  BILL
  BILL_PAYMENT
  BANK_TRANSFER
  ADJUSTMENT
  REVERSAL
}

model JournalEntry {
  id             String  @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  entryNumber    String
  /// Date of the underlying business event.
  transactionDate DateTime
  /// Date the amounts hit the books; this is what reports and locks key on.
  postingDate    DateTime
  status         JournalStatus @default(DRAFT)
  sourceType     SourceType
  /// The document that generated this entry, for drill-down and reversal.
  sourceId       String?
  reference      String?
  memo           String

  totalDebit     Decimal @default(0) @db.Decimal(19, 2)
  totalCredit    Decimal @default(0) @db.Decimal(19, 2)

  fiscalPeriodId String?
  fiscalPeriod   FiscalPeriod? @relation(fields: [fiscalPeriodId], references: [id])

  preparedById   String?
  approvedById   String?
  postedById     String?
  postedAt       DateTime?

  /// Set on the original entry once a reversal has been posted against it.
  reversedByEntryId String?
  reversalOfEntryId String?

  /// Duplicate-posting protection for API-driven entries.
  idempotencyKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines JournalLine[]

  // Reverse side of the 1:1 document links. A posted entry is reachable from
  // the document that produced it, and the unique FK guarantees one entry per
  // document so a retry cannot post twice.
  invoice     Invoice?       @relation("InvoiceJournal")
  creditNote  CreditNote?    @relation("CreditNoteJournal")
  receipt     Receipt?       @relation("ReceiptJournal")
  bill        Bill?          @relation("BillJournal")
  billPayment BillPayment?   @relation("BillPaymentJournal")
  bankTransfer BankTransfer? @relation("BankTransferJournal")

  @@unique([organizationId, entryNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, postingDate])
  @@index([organizationId, status])
  @@index([sourceType, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id            String  @id
  entryId       String
  entry         JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  accountId     String
  account       Account  @relation(fields: [accountId], references: [id])
  description   String?

  debit         Decimal @default(0) @db.Decimal(19, 2)
  credit        Decimal @default(0) @db.Decimal(19, 2)

  // Reporting dimensions. Analysis is carried on the line, so segment and
  // project reporting reads the ledger rather than a mirrored summary table.
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id])

  @@index([accountId])
  @@index([projectId])
  @@index([entryId])
  @@map("journal_lines")
}

// ---------------------------------------------------------------------------
// Sales: invoices, credit notes, receipts
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOIDED
}

model Invoice {
  id             String  @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  invoiceNumber String
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id])

  status     InvoiceStatus @default(DRAFT)
  issueDate  DateTime
  dueDate    DateTime

  subtotal   Decimal @default(0) @db.Decimal(19, 2)
  taxRate    Decimal @default(0) @db.Decimal(9, 4)
  taxAmount  Decimal @default(0) @db.Decimal(19, 2)
  discountAmount Decimal @default(0) @db.Decimal(19, 2)
  totalAmount Decimal  @db.Decimal(19, 2)

  notes String?

  /// Present only once the document has posted; draft invoices have no ledger effect.
  journalEntryId String? @unique
  journalEntry   JournalEntry? @relation("InvoiceJournal", fields: [journalEntryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items        InvoiceItem[]
  allocations  PaymentAllocation[]
  creditNotes  CreditNote[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String
  quantity    Decimal @default(1) @db.Decimal(19, 6)
  unitPrice   Decimal @default(0) @db.Decimal(19, 6)
  amount      Decimal @db.Decimal(19, 2)
  accountId   String?
  projectId   String?

  @@index([invoiceId])
  @@map("invoice_items")
}

enum CreditNoteStatus {
  DRAFT
  ISSUED
  APPLIED
  VOIDED
}

/// Required by the posted-equals-reverse-only policy: reducing or refunding an
/// issued invoice is done with a credit note, never by editing the invoice.
model CreditNote {
  id             String  @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  creditNoteNumber String
  clientId         String
  client           Client   @relation(fields: [clientId], references: [id])
  invoiceId        String?
  invoice          Invoice?  @relation(fields: [invoiceId], references: [id])

  status    CreditNoteStatus @default(DRAFT)
  issueDate DateTime
  reason    String

  subtotal  Decimal @db.Decimal(19, 2)
  taxAmount Decimal @default(0) @db.Decimal(19, 2)
  totalAmount Decimal @db.Decimal(19, 2)

  journalEntryId String? @unique
  journalEntry   JournalEntry? @relation("CreditNoteJournal", fields: [journalEntryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       CreditNoteItem[]
  allocations PaymentAllocation[]

  @@unique([organizationId, creditNoteNumber])
  @@index([organizationId, status])
  @@map("credit_notes")
}

model CreditNoteItem {
  id           String     @id
  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  description String
  quantity    Decimal @default(1) @db.Decimal(19, 6)
  unitPrice   Decimal @default(0) @db.Decimal(19, 6)
  amount      Decimal @db.Decimal(19, 2)

  @@index([creditNoteId])
  @@map("credit_note_items")
}

enum ReceiptStatus {
  DRAFT
  RECORDED
  VOIDED
}

/// Client receipts. Over-receipt is legal: the excess stays unapplied instead
/// of being force-allocated onto an invoice.
model Receipt {
  id             String  @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  receiptNumber String
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])

  status      ReceiptStatus @default(DRAFT)
  receiptDate DateTime
  amount      Decimal  @db.Decimal(19, 2)
  unappliedAmount Decimal @default(0) @db.Decimal(19, 2)

  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])

  paymentMethod String    @default("BANK_TRANSFER")
  reference     String?
  notes         String?

  journalEntryId String? @unique
  journalEntry   JournalEntry? @relation("ReceiptJournal", fields: [journalEntryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations PaymentAllocation[]

  @@unique([organizationId, receiptNumber])
  @@index([organizationId, status])
  @@map("receipts")
}

/// One receipt may settle several invoices and be reduced by several credit
/// notes; the legacy code accepted a single invoice id and could not express
/// either case.
model PaymentAllocation {
  id             String  @id
  receiptId      String?
  receipt        Receipt?  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  creditNoteId   String?
  creditNote     CreditNote? @relation(fields: [creditNoteId], references: [id])
  invoiceId      String?
  invoice        Invoice?    @relation(fields: [invoiceId], references: [id])

  allocatedAmount Decimal @db.Decimal(19, 2)
  allocatedAt     DateTime @default(now())

  @@index([receiptId])
  @@index([invoiceId])
  @@index([creditNoteId])
  @@map("payment_allocations")
}

// ---------------------------------------------------------------------------
// Purchases: bills and disbursements
// ---------------------------------------------------------------------------

enum BillStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_PAID
  PAID
  REJECTED
  VOIDED
}

model Bill {
  id             String  @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  billNumber String
  vendorId   String
  vendor     Vendor   @relation(fields: [vendorId], references: [id])
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])

  status    BillStatus @default(PENDING_APPROVAL)
  billDate  DateTime
  dueDate   DateTime

  subtotal  Decimal @db.Decimal(19, 2)
  taxAmount Decimal @default(0) @db.Decimal(19, 2)
  totalAmount Decimal @db.Decimal(19, 2)

  description String?
  approvedById String?
  approvedAt   DateTime?

  journalEntryId String? @unique
  journalEntry   JournalEntry? @relation("BillJournal", fields: [journalEntryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines    BillLine[]
  payments BillPayment[]

  @@unique([organizationId, billNumber])
  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@map("bills")
}

/// Bills are itemised so one document can charge several expense accounts,
/// which the single `expense_account_id` column could not.
model BillLine {
  id        String @id
  billId    String
  bill      Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)

  description String
  amount      Decimal @db.Decimal(19, 2)
  accountId   String
  projectId   String?

  @@index([billId])
  @@map("bill_lines")
}

model BillPayment {
  id             String  @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  paymentNumber String
  billId        String
  bill          Bill   @relation(fields: [billId], references: [id])
  vendorId      String
  vendor        Vendor @relation(fields: [vendorId], references: [id])

  status      ReceiptStatus @default(DRAFT)
  paymentDate DateTime
  amount      Decimal  @db.Decimal(19, 2)

  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])

  paymentMethod String @default("BANK_TRANSFER")
  reference     String?

  journalEntryId String? @unique
  journalEntry   JournalEntry? @relation("BillPaymentJournal", fields: [journalEntryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, paymentNumber])
  @@map("bill_payments")
}

// ---------------------------------------------------------------------------
// Banking
// ---------------------------------------------------------------------------

model BankAccount {
  id             String  @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  accountId     String
  account       Account  @relation(fields: [accountId], references: [id])

  name          String
  bankName      String
  accountNumber String
  currencyCode  String
  isPettyCash   Boolean  @default(false)
  isOpeningBalanceEntered Boolean @default(false)
  isArchived    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receipts     Receipt[]
  billPayments BillPayment[]
  statements   BankStatement[]
  transfers    BankTransfer[] @relation("TransferFrom")
  transfersIn  BankTransfer[] @relation("TransferTo")

  @@index([organizationId])
  @@map("bank_accounts")
}

model BankTransfer {
  id             String  @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccountId  String
  account        BankAccount @relation("TransferFrom", fields: [bankAccountId], references: [id])

  toBankAccountId String
  toBankAccount   BankAccount @relation("TransferTo", fields: [toBankAccountId], references: [id])

  transferDate DateTime
  amount       Decimal @db.Decimal(19, 2)
  reference    String?
  notes        String?

  journalEntryId String? @unique
  journalEntry   JournalEntry? @relation("BankTransferJournal", fields: [journalEntryId], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@map("bank_transfers")
}

/// Statement lines imported for reconciliation. The legacy schema had this
/// table with no code path at all; reconciliation is a later phase, but the
/// shape is reserved so the import contract is designed alongside the ledger.
model BankStatement {
  id             String  @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])

  importedAt DateTime @default(now())
  source     String   @default("manual")

  lines BankStatementLine[]

  @@index([organizationId])
  @@map("bank_statements")
}

model BankStatementLine {
  id         String @id
  statementId String
  statement   BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  transactionDate DateTime
  description     String
  reference       String?
  amount          Decimal @db.Decimal(19, 2)

  isReconciled    Boolean @default(false)
  matchedEntryId  String?

  @@index([statementId])
  @@map("bank_statement_lines")
}

// ---------------------------------------------------------------------------
// Internal controls
// ---------------------------------------------------------------------------

/// Append-only. There is no update or delete path in the application, and the
/// migration revoke UPDATE/DELETE on this table so a bug cannot rewrite history.
model AuditEvent {
  id             String  @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  actorId     String?
  actorEmail  String?
  action      String
  entityType  String
  entityId    String?
  details     String
  ipAddress   String?

  timestamp DateTime @default(now())

  @@index([organizationId, timestamp])
  @@index([organizationId, entityType, entityId])
  @@map("audit_events")
}
