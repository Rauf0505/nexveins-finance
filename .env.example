# PostgreSQL reached by Prisma and the application runtime.
# Matches docker-compose.yml defaults; override for any shared or production host.
DATABASE_URL=postgresql://nexveins:nexveins_dev_only@localhost:5432/nexveins_finance?schema=public

# Better Auth. Base URL of the running app; the secret must be replaced in
# any environment that is not a local machine.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-value

# Development only. Exposes the "impersonate membership" debug route so the
# RBAC matrix can be exercised as different roles. Never set in production.
AUTH_DEBUG_IMPERSONATE=1
